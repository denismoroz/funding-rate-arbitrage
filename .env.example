# Hyperliquid network mode: paper | testnet | mainnet
FRAB_HL_NETWORK=paper

# Required when FRAB_HL_NETWORK != paper
# FRAB_HL_PRIVATE_KEY=0x...
# FRAB_HL_ACCOUNT_ADDRESS=0x...

# Universe override (comma-separated). Empty → use server.py DEFAULT_COINS.
# Testnet recommended: PURR,HYPE
# Mainnet recommended: BTC,ETH,SOL,AVAX,LINK,AAVE
# FRAB_HL_UNIVERSE=PURR,HYPE

# Risk caps for live modes
FRAB_HL_MAX_OPEN_POSITIONS=5
FRAB_HL_POSITION_SIZE_USD=10.0
