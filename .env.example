# Hyperliquid network mode: testnet | mainnet
FRAB_HL_NETWORK=mainnet

# Required for live trading
# FRAB_HL_PRIVATE_KEY=0x...
# FRAB_HL_ACCOUNT_ADDRESS=0x...

# Risk caps
FRAB_HL_MAX_OPEN_POSITIONS=5

# ──────────────────────────────────────────────────────────────────────────
# Margin policy. These are global guard thresholds; per-coin leverage and
# maint_ratio are configured in the coin_registry table (via UI Settings).
#
FRAB_BUDGET_CAP_USD=1000       # total committed cap (spot notional + locked margin)
FRAB_MARGIN_BUFFER_X=3.0       # reserve 3× of HL initial margin per position
FRAB_TOP_UP_TRIGGER=2.0        # watchdog tops up below this ratio
FRAB_HEALTHY_RATIO=3.0         # top-up target ratio (and OPEN guard)

# ── XSMOM (optional second strategy) ──────────────────────────────────────
# FRAB_XSMOM_HL_PRIVATE_KEY=0x...
# FRAB_XSMOM_HL_ACCOUNT_ADDRESS=0x...
