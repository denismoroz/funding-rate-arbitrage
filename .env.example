# Hyperliquid network mode: paper | testnet | mainnet
FRAB_HL_NETWORK=paper

# Required when FRAB_HL_NETWORK != paper
# FRAB_HL_PRIVATE_KEY=0x...
# FRAB_HL_ACCOUNT_ADDRESS=0x...

# Universe override (comma-separated). Empty → use server.py DEFAULT_COINS.
# Testnet recommended: PURR,HYPE
# Mainnet recommended: BTC,ETH,SOL,AVAX,LINK,AAVE
# FRAB_HL_UNIVERSE=PURR,HYPE

# Risk caps for live modes
FRAB_HL_MAX_OPEN_POSITIONS=5
FRAB_HL_POSITION_SIZE_USD=10.0   # ignored when FRAB_PER_COIN_PARAMS_JSON is set

# ──────────────────────────────────────────────────────────────────────────
# Margin policy (Phase C/D/E). When FRAB_PER_COIN_PARAMS_JSON is empty,
# the legacy uniform-sizing path (above) is used and the watchdog is OFF.
#
# When it is set:
#   - per-coin leverage + maintenance ratio drive C2 pre-flight + C3 watchdog
#   - position_size_usd is OPTIONAL — omit it for all coins to auto-derive
#     sizes from budget_cap_usd / max_open_positions / margin_buffer_x:
#         size_i = (budget_cap / K) / (1 + buffer / leverage_i)
#   - mixed mode (some coins with explicit size, others without) is rejected
#
# Recommended HL config for 3-coin universe (BTC/ETH/SOL):
# FRAB_PER_COIN_PARAMS_JSON={"BTC":{"leverage":20,"maint_ratio":0.01},"ETH":{"leverage":20,"maint_ratio":0.01},"SOL":{"leverage":10,"maint_ratio":0.025}}
# FRAB_BUDGET_CAP_USD=60         # total committed cap (spot + locked margin)
# FRAB_MARGIN_BUFFER_X=3.0       # reserve 3× of HL initial margin per pos
# FRAB_TOP_UP_TRIGGER=2.0        # watchdog tops up below this ratio
# FRAB_HEALTHY_RATIO=3.0         # top-up target ratio (and OPEN guard)
